  <data key="d8">หัวหนาสวนราชการ is responsible for supervising and directing the activities of a ผูรับผิดชอบ in their administrative capacity.</data>
  <data key="d9">oversees</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-004</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1789045495</data>
  <data key="d13"></data>
</edge>
<edge source="ข้อตกลง" target="การรับหนังสือ">
  <data key="d7">1.0</data>
  <data key="d8">The agreement outlines the rules that govern how books should be received and processed.</data>
  <data key="d9">governs</data>
