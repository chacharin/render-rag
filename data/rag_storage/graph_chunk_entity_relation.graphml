  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ตำแหน่ง">
  <data key="d0">ตำแหน่ง</data>
  <data key="d1">concept</data>
  <data key="d2">The official position or title of the individual who has signed a regulation or announcement.&lt;SEP&gt;The official position or title of the person who issues the announcement or statement, which must be included in the document.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-007&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ขอความ">
  <data key="d0">ขอความ</data>
  <data key="d1">concept</data>
  <data key="d2">Textual clauses or statements that outline the specifics of the regulatory requirements or reasons for regulation issuance.&lt;SEP&gt;The detailed notes or minutes recorded during the meeting, typically including the discussions, decisions, and summaries of each agenda item.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-007&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ฉบับที่">
  <data key="d0">ฉบับที่</data>
  <data key="d1">data</data>
  <data key="d2">The edition or version number of a regulatory document, which differentiates between original and amended versions.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-007</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="อํานาจของกฎหมาย">
  <data key="d0">อํานาจของกฎหมาย</data>
  <data key="d1">concept</data>
  <data key="d2">The power or authority granted by legal statutes that enables an individual or organization to enforce regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-007</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ประกาศ">
  <data key="d0">ประกาศ</data>
  <data key="d1">content</data>
  <data key="d2">A type of written notification published by government authority to inform or guide the public about certain matters or practices.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-031</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="แถลงการณ">
  <data key="d0">แถลงการณ</data>
  <data key="d1">content</data>
  <data key="d2">A type of official statement or announcement made by government authority to clarify or provide information about governmental affairs or incidents.&lt;SEP&gt;แถลงการณ์เป็นการประกาศหรือการสื่อสารอย่างเป็นทางการที่ออกโดยหน่วยงานราชการ เพื่อแสดงเหตุผลหรือข้อมูลที่สำคัญ</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หนังสือประชาสัมพันธ">
  <data key="d0">หนังสือประชาสัมพันธ</data>
  <data key="d1">content</data>
  <data key="d2">A category of documents used for public communication, including announcements and statements issued by government authorities.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="รายละเอียด">
  <data key="d0">รายละเอียด</data>
  <data key="d1">concept</data>
  <data key="d2">The specific information or particulars that need to be filled in or addressed in formal documents such as announcements or statements.&lt;SEP&gt;Specific information that must be accurately recorded when handling books, as outlined in procedural steps.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-014</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ต้นแบบที่กำหนด">
  <data key="d0">ต้นแบบที่กำหนด</data>
  <data key="d1">method</data>
  <data key="d2">A prescribed format or template that public announcements or statements must follow according to regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ข่าว">
  <data key="d0">ข่าว</data>
  <data key="d1">content</data>
  <data key="d2">ข่าวเป็นเอกสารที่ทางราชการเห็นสมควรเผยแพร่เพื่อให้ข้อมูลแก่ประชาชน โดยจะมีชื่อเรื่องและรายละเอียดเกี่ยวกับเรื่องนั้นๆ ที่ถูกจัดทำตามแบบที่กำหนดไว้</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หนังสือรับรอง">
  <data key="d0">หนังสือรับรอง</data>
  <data key="d1">content</data>
  <data key="d2">หนังสือรับรองเป็นเอกสารที่ออกโดยส่วนราชการเพื่อรับรองข้อมูลหรือสถานะของบุคคล นิติบุคคล หรือหน่วยงานให้เป็นที่รู้จักแก่บุคคลโดยทั่วไป</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ราชการ">
  <data key="d0">ราชการ</data>
  <data key="d1">organization</data>
  <data key="d2">ราชการหมายถึงหน่วยงานหรือองค์กรมหาชนที่มีอำนาจในการดำเนินการต่างๆ ในการบริการหรือการบริหารงานของรัฐ&lt;SEP&gt;ราชการ refers to government bodies or authorities in Thailand that are responsible for public administration and governance.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-028</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="บันทึก">
  <data key="d0">บันทึก</data>
  <data key="d1">content</data>
  <data key="d2">บันทึกหมายถึงเอกสารที่ใช้ในการบันทึกข้อมูลหรือเหตุการณ์ต่างๆ ที่เกิดขึ้น โดยมักใช้ในบริบทของการประชุม การสื่อสาร หรือการดำเนินการราชการ</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="รายงานการประชุม">
  <data key="d0">รายงานการประชุม</data>
  <data key="d1">content</data>
  <data key="d2">รายงานการประชุมเป็นเอกสารที่สรุปผลการประชุม โดยมีข้อมูลเกี่ยวกับหัวข้อที่หารือ ผู้เข้าร่วมประชุม และกรอบเวลาในการดำเนินการ</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หน่วยงาน">
  <data key="d0">หน่วยงาน</data>
  <data key="d1">organization</data>
  <data key="d2">หน่วยงานเป็นสถานที่หรือกลุ่มที่มีการดำเนินงานเฉพาะด้าน เช่น หน่วยงานราชการหรือองค์กรของรัฐที่เรียกรวมว่า 'ราชการ'&lt;SEP&gt;Any governmental or organizational body that employs individuals and requires documentation for legitimacy.&lt;SEP&gt;The term "หน่วยงาน" refers to various organizations or agencies involved in the administrative process of document handling and management within government operations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-010&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-015</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="บุคคล">
  <data key="d0">บุคคล</data>
  <data key="d1">person</data>
  <data key="d2">บุคคลหมายถึงมนุษย์ทั่วไปที่สามารถมีสถานะหรือบทบาทในมุมมองของเอกสารราชการ&lt;SEP&gt;Individuals whose names must be fully written out in legal documents, including their titles and employment details.&lt;SEP&gt;The term "บุคคล" refers to individuals or persons mentioned in the context of handling documents or relevant administrative tasks, particularly those involved in signing or acknowledging receipt of documents.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-010&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-015</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="นิติบุคคล">
  <data key="d0">นิติบุคคล</data>
  <data key="d1">other</data>
  <data key="d2">นิติบุคคลหมายถึงองค์ธุรกิจหรือองค์กรที่มีการจัดตั้งโดยกฎหมาย ซึ่งสามารถทำธุรกรรมทางกฎหมายเช่นเดียวกับบุคคล&lt;SEP&gt;Legal entities that are recognized by the law, requiring proper documentation and identification in formal processes.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ส่วนราชการเจ้า">
  <data key="d0">ส่วนราชการเจ้า</data>
  <data key="d1">organization</data>
  <data key="d2">The government agency responsible for the legal document, which is mentioned as having ownership over the document.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หัวหน้าส่วนราชการ">
  <data key="d0">หัวหน้าส่วนราชการ</data>
  <data key="d1">person</data>
  <data key="d2">The head of the government agency responsible for signing the document, ensuring it adheres to formal legal processes.&lt;SEP&gt;A head of governmental units responsible for approving the borrowing and destruction of documents.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="รูปถ่าย">
  <data key="d0">รูปถ่าย</data>
  <data key="d1">artifact</data>
  <data key="d2">A photograph required to accompany the certification process, adhering to specific sizing and appearance guidelines.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การประชุม">
  <data key="d0">การประชุม</data>
  <data key="d1">event</data>
  <data key="d2">A formal gathering of individuals to discuss and record opinions, contributions, and decisions pertinent to governmental or organizational matters.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="คณะที่ประชุม">
  <data key="d0">คณะที่ประชุม</data>
  <data key="d1">organization</data>
  <data key="d2">A committee formed from individuals attending a meeting, responsible for the meeting's outcomes and documentation.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="สถานที่ประชุม">
  <data key="d0">สถานที่ประชุม</data>
  <data key="d1">location</data>
  <data key="d2">The physical location where the meeting is held, which must be specified in the minutes of the meeting.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="มติของที่ประชุม">
  <data key="d0">มติของที่ประชุม</data>
  <data key="d1">concept</data>
  <data key="d2">The resolutions or decisions reached during a meeting that are documented as formal outcomes.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เวลาที่ประชุม">
  <data key="d0">เวลาที่ประชุม</data>
  <data key="d1">data</data>
  <data key="d2">The time specification for when a meeting occurs, which must be recorded in the minutes of the meeting.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="จำนวนที่ประชุม">
  <data key="d0">จำนวนที่ประชุม</data>
  <data key="d1">data</data>
  <data key="d2">The number of attendees at the meeting, which should also be noted in the documentation.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="บันทึกความคิดเห็น">
  <data key="d0">บันทึกความคิดเห็น</data>
  <data key="d1">content</data>
  <data key="d2">The written record of participants' opinions and discussions that occurs during a meeting.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผูได้รับแตงตั้ง">
  <data key="d0">ผูได้รับแตงตั้ง</data>
  <data key="d1">person</data>
  <data key="d2">A person who has been appointed to attend a meeting as a representative or member of a committee.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ที่ประชุม">
  <data key="d0">ที่ประชุม</data>
  <data key="d1">event</data>
  <data key="d2">An assembly or meeting where individuals gather to discuss specific topics or issues.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผูที่มาประชุมแทน">
  <data key="d0">ผูที่มาประชุมแทน</data>
  <data key="d1">person</data>
  <data key="d2">A person who attends a meeting on behalf of another individual, requiring their name and position to be recorded.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผูไมมาประชุม">
  <data key="d0">ผูไมมาประชุม</data>
  <data key="d1">person</data>
  <data key="d2">A person who is unable to attend a meeting and must provide their name and reason for absence.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผูเขารวมประชุม">
  <data key="d0">ผูเขารวมประชุม</data>
  <data key="d1">person</data>
  <data key="d2">A person who participates in a meeting but is not part of the official committee.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ประธาน">
  <data key="d0">ประธาน</data>
  <data key="d1">person</data>
  <data key="d2">The chairperson who opens the meeting and leads the discussions.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผูจดรายงานการประชุม">
  <data key="d0">ผูจดรายงานการประชุม</data>
  <data key="d1">person</data>
  <data key="d2">The individual responsible for taking notes or minutes during the meeting.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผู้บังคับบัญชา">
  <data key="d0">ผู้บังคับบัญชา</data>
  <data key="d1">person</data>
  <data key="d2">A superior or manager who oversees subordinates and may issue orders or directives.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หนวยงานระดับตํ่">
  <data key="d0">หนวยงานระดับตํ่</data>
  <data key="d1">organization</data>
  <data key="d2">An organization that operates at a lower administrative level within a governmental body.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="กระดาษบันทึกขอความ">
  <data key="d0">กระดาษบันทึกขอความ</data>
  <data key="d1">artifact</data>
  <data key="d2">A physical document used to record minutes or important notes of discussions held in meetings.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หนังสืออื่น">
  <data key="d0">หนังสืออื่น</data>
  <data key="d1">content</data>
  <data key="d2">A type of book or document created by officials as evidence for government purposes, which includes photographs, films, sound recordings, and video recordings.&lt;SEP&gt;Any additional documents or papers generated as evidence in government operations, including photos, films, or audio recordings.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-012</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เหตุผล">
  <data key="d0">เหตุผล</data>
  <data key="d1">concept</data>
  <data key="d2">The justification or reasoning provided by individuals who are marked as absent from the meeting.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เวลาที่เริ่มประชุม">
  <data key="d0">เวลาที่เริ่มประชุม</data>
  <data key="d1">data</data>
  <data key="d2">The recorded time when the meeting officially begins.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เวลาที่เลิกประชุม">
  <data key="d0">เวลาที่เลิกประชุม</data>
  <data key="d1">data</data>
  <data key="d2">The recorded time when the meeting officially concludes.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="วันเดือนปีที่บันทึก">
  <data key="d0">วันเดือนปีที่บันทึก</data>
  <data key="d1">data</data>
  <data key="d2">The specific date recorded when the minutes or notes are taken during the meeting.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เจาหนาที่">
  <data key="d0">เจาหนาที่</data>
  <data key="d1">person</data>
  <data key="d2">Refers to officials responsible for handling documents and ensuring they are processed according to regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-012</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="กระทรวง">
  <data key="d0">กระทรวง</data>
  <data key="d1">organization</data>
  <data key="d2">A government ministry that defines the formats for documents submitted to officials, ensuring they meet legal standards.&lt;SEP&gt;กระทรวง refers to the Ministry, a form of government authority responsible for specific sector administration in Thailand.&lt;SEP&gt;กระทรวง refers to ministries in Thailand, which are departments responsible for specific areas of public policy, government function, and public service.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-012&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-022&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-028</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
