</node>
<node id="กรม">
  <data key="d0">กรม</data>
  <data key="d1">organization</data>
  <data key="d2">กรม is an administrative organization that operates at a national level, responsible for various governmental functions and services within Thailand.&lt;SEP&gt;กรม refers to a department or bureau within a ministry responsible for specialized areas of administration.&lt;SEP&gt;กรม refers to departments under various governmental ministries in Thailand, responsible for specific administrative functions.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-004&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-022&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-028</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผูรับผิดชอบ">
