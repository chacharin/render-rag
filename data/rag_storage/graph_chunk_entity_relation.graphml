  <data key="d1">person</data>
  <data key="d2">A leadership position within government departments responsible for administrative decisions and oversight in Thailand.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-026</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
