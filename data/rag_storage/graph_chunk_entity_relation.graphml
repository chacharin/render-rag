<node id="การเก็บรักษา">
  <data key="d0">การเก็บรักษา</data>
  <data key="d1">method</data>
  <data key="d2">The process of maintaining and preserving documents, including organizing them for retrieval or destruction.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-018</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การเก็บระหว่างปฏิบัติ">
  <data key="d0">การเก็บระหว่างปฏิบัติ</data>
  <data key="d1">method</data>
  <data key="d2">A procedure focused on storing documents that are still being processed, ensuring they remain the responsibility of the assigned individual.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-018</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การเก็บเมื่อปฏิบัติเสร็จแล้ว">
  <data key="d0">การเก็บเมื่อปฏิบัติเสร็จแล้ว</data>
  <data key="d1">method</data>
  <data key="d2">A procedure for storing documents that have completed processing and no further action is required.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-018</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การบันทึกการปฏิบัติ">
  <data key="d0">การบันทึกการปฏิบัติ</data>
  <data key="d1">method</data>
  <data key="d2">The documentation process that tracks the handling of a particular document, noting its progress and final disposition.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-018</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การเก็บหนังสือ">
  <data key="d0">การเก็บหนังสือ</data>
  <data key="d1">method</data>
  <data key="d2">The process of storing documents with specific guidelines, including duration and handling instructions.&lt;SEP&gt;Refers to the practice of retaining books that have been completed for ongoing verification, ensuring their availability for inspection rather than sending them to storage departments.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-019&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การตรวจสอบ">
  <data key="d0">การตรวจสอบ</data>
  <data key="d1">concept</data>
  <data key="d2">The act of examining or verifying documents that have been stored, ensuring compliance and correctness.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-019</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ตรา">
  <data key="d0">ตรา</data>
  <data key="d1">artifact</data>
  <data key="d2">A stamp used for marking documents for storage or verification purposes in an official context.&lt;SEP&gt;ตรา refers to an official seal or emblem used in various governmental or legal documents in Thailand.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-019&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-028</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="อายุการเก็บหนังสือ">
  <data key="d0">อายุการเก็บหนังสือ</data>
  <data key="d1">concept</data>
  <data key="d2">The period during which a document should be kept, including specific instructions for indefinite retention or destruction.&lt;SEP&gt;Refers to the specified duration for which documents should be retained before they can be disposed of, depending on their classification and importance.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-019&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หน่วยเก็บ">
  <data key="d0">หน่วยเก็บ</data>
  <data key="d1">organization</data>
  <data key="d2">The administrative unit responsible for the storage and management of documents in a governmental context.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-019</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หน่วยเก็บของส่วนราชการ">
  <data key="d0">หน่วยเก็บของส่วนราชการ</data>
  <data key="d1">organization</data>
  <data key="d2">Refers to the governmental storage unit responsible for the management and retention of documents and records as per regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เจ้าเรื่อง">
  <data key="d0">เจ้าเรื่อง</data>
  <data key="d1">person</data>
  <data key="d2">Refers to the individual responsible for overseeing the retention of documents as specified in the guidelines.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="กรมศิลปากร">
  <data key="d0">กรมศิลปากร</data>
  <data key="d1">organization</data>
  <data key="d2">กรมศิลปากร is an organization responsible for the preservation and management of national cultural heritage in Thailand.&lt;SEP&gt;กรมศิลปากร is a national bureau responsible for the preservation and management of cultural heritage in Thailand.&lt;SEP&gt;The Department of Fine Arts in Thailand, responsible for preservation of historical documents, cultural artifacts, and records.&lt;SEP&gt;Department of Fine Arts in Thailand, responsible for cultural heritage, art, and historical documentation.&lt;SEP&gt;An official government department in Thailand responsible for cultural heritage and historical document management.&lt;SEP&gt;A national agency in Thailand responsible for the preservation of art and cultural heritage, involved in decisions regarding the destruction of documents.&lt;SEP&gt;The Department of Fine Arts in Thailand that oversees cultural heritage conservation, including historical documents and artworks.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-021&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-022&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-023&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-025&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-026&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-027</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="กองจดหมายเหตุแห่งชาติ">
  <data key="d0">กองจดหมายเหตุแห่งชาติ</data>
  <data key="d1">organization</data>
  <data key="d2">กองจดหมายเหตุแห่งชาติ is a national archival office in Thailand that manages historical documents and records.&lt;SEP&gt;The National Archives of Thailand, which manages and oversees the preservation of historical documents and records.&lt;SEP&gt;A national archive and repository for preserving historical documents in Thailand.&lt;SEP&gt;An organization under the Ministry of Culture responsible for preserving and managing historical documents within Thailand.&lt;SEP&gt;หน่วยงานที่ดูแลการเก็บรักษาเอกสารสำคัญและประวัติศาสตร์ของชาติ สังกัดกรมศิลปากร</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-022&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-025&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-027&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-031</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หนังสือที่ต้องสงวนเป็นความลับ">
  <data key="d0">หนังสือที่ต้องสงวนเป็นความลับ</data>
  <data key="d1">concept</data>
  <data key="d2">Refers to documents that must be kept confidential in accordance with national security laws and regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หนังสือหลักฐานทางอรรถคดี">
  <data key="d0">หนังสือหลักฐานทางอรรถคดี</data>
  <data key="d1">concept</data>
  <data key="d2">Refers to documents that serve as legal evidence according to judicial regulations and must be preserved accordingly.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การทำลายเอกสาร">
  <data key="d0">การทำลายเอกสาร</data>
  <data key="d1">method</data>
  <data key="d2">Refers to the procedure of destroying documents that are no longer needed, requiring agreements with the Ministry of Finance.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เอกสารสิทธิ">
  <data key="d0">เอกสารสิทธิ</data>
  <data key="d1">concept</data>
  <data key="d2">Refers to documents that represent rights, which are specifically mentioned as not being included in the retention list unless necessary.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การศึกษาค้นคว้า">
  <data key="d0">การศึกษาค้นคว้า</data>
  <data key="d1">method</data>
  <data key="d2">Refers to the process of researching and studying the contents of documents, which is mentioned in the context of retaining historical records.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="กองจดหมายเหต ุแหงชาติ">
  <data key="d0">กองจดหมายเหต ุแหงชาติ</data>
  <data key="d1">organization</data>
  <data key="d2">กองจดหมายเหต ุแหงชาติ is a division that manages national archives and historical documents in Thailand.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-021</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="บัญชีหนังสือครบ ๒๕ ปี">
  <data key="d0">บัญชีหนังสือครบ ๒๕ ปี</data>
  <data key="d1">concept</data>
  <data key="d2">บัญชีหนังสือครบ ๒๕ ปี refers to the official record or account maintained for documents that have been kept for twenty-five years.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-021</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เป็นหนังสือที่มีความสำคัญ">
  <data key="d0">เป็นหนังสือที่มีความสำคัญ</data>
  <data key="d1">concept</data>
  <data key="d2">เป็นหนังสือที่มีความสำคัญ refers to a classification of documents that are considered significant and should be preserved.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-022</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ทบวง">
  <data key="d0">ทบวง</data>
  <data key="d1">organization</data>
  <data key="d2">ทบวง refers to the overarching regulations or frameworks under which the ministries operate.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-022</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="กอง">
  <data key="d0">กอง</data>
  <data key="d1">organization</data>
  <data key="d2">กอง refers to a division within a department that focuses on specific responsibilities or tasks.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-022</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ขอเก็บเอง">
  <data key="d0">ขอเก็บเอง</data>
  <data key="d1">concept</data>
  <data key="d2">ขอเก็บเอง refers to the process of requesting to retain documents personally.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-022</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="บัญชีหนังสือครบ ๒๕ ปี ที่ขอเก็บเอง">
  <data key="d0">บัญชีหนังสือครบ ๒๕ ปี ที่ขอเก็บเอง</data>
  <data key="d1">content</data>
  <data key="d2">บัญชีหนังสือครบ ๒๕ ปี ที่ขอเก็บเอง is a record list of books that an individual requests to keep for 25 years.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-022</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="กระทรวง ทบวง กรม กอง">
  <data key="d0">กระทรวง ทบวง กรม กอง</data>
  <data key="d1">organization</data>
  <data key="d2">An organization that is responsible for various governmental functions in Thailand, involved in the administration of documents and accounting.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="กองจดหมายเหตุแหงชาติ">
  <data key="d0">กองจดหมายเหตุแหงชาติ</data>
  <data key="d1">organization</data>
  <data key="d2">The National Archives of Thailand, tasked with the preservation and management of governmental records and documents.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผู้ฝาก">
  <data key="d0">ผู้ฝาก</data>
  <data key="d1">person</data>
  <data key="d2">An individual or entity that submits documents or books for archiving.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผู้รับฝาก">
  <data key="d0">ผู้รับฝาก</data>
  <data key="d1">person</data>
  <data key="d2">An individual or entity that receives documents or books for archiving.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="บัญชีฝากหนังสือ">
  <data key="d0">บัญชีฝากหนังสือ</data>
  <data key="d1">content</data>
  <data key="d2">A register or account book used for keeping track of documents submitted for archiving, detailing the titles, submission dates, and other relevant information.&lt;SEP&gt;บัญชีฝากหนังสือเป็นบัญชีที่ใช้ลงรายการหนังสือที่ส่วนราชการนำฝากไว้กับกองจดหมายเหตุแห่งชาติ กรมศิลปากร&lt;SEP&gt;บัญชีที่ใช้งานสำหรับลงรายการหนังสือที่ส่วนราชการนำฝากไว้กับกองจดหมายเหตุแห่งชาติ กรมศิลปากร โดยมีลักษณะเป็นแผ่นขนาดเอ 4 พิมพ์สองหน้า ตามแบบที่ 23</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-030&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-031</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การยืม">
  <data key="d0">การยืม</data>
  <data key="d1">concept</data>
  <data key="d2">A procedure concerning the borrowing of books and associated documentation within governmental sections, including details on requirements and responsibilities for borrowers and custodians.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ผูยืม">
  <data key="d0">ผูยืม</data>
  <data key="d1">person</data>
  <data key="d2">An individual who borrows books from a library or governmental repository; responsible for notifying the purpose of borrowing and adhering to the established borrowing protocols.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เจาหนาที่เก็บ">
  <data key="d0">เจาหนาที่เก็บ</data>
  <data key="d1">person</data>
  <data key="d2">A staff member in charge of managing books and records in a library or repository, responsible for collecting and tracking borrowing evidence and ensuring compliance with rules.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เอกสารสิทธิตามกฎหมาย">
  <data key="d0">เอกสารสิทธิตามกฎหมาย</data>
  <data key="d1">content</data>
  <data key="d2">Legal documents that provide evidence of rights or ownership, which must be reported if lost and require specific procedures for replacement.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="หลักฐานการยืม">
  <data key="d0">หลักฐานการยืม</data>
  <data key="d1">content</data>
  <data key="d2">Documentation required for the borrowing of books, which must verify the borrowing agreement and the details of the transaction.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="การยืมหนังสือ">
  <data key="d0">การยืมหนังสือ</data>
  <data key="d1">concept</data>
  <data key="d2">A defined procedure particularly related to lending books, featuring guidelines on how borrowing should be conducted within governmental or official contexts.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เจ้าหน้าที่">
  <data key="d0">เจ้าหน้าที่</data>
  <data key="d1">person</data>
  <data key="d2">A person responsible for document handling within an organization who manages the borrowing and destruction of documents.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="คณะกรรมการทําลายหนังสือ">
  <data key="d0">คณะกรรมการทําลายหนังสือ</data>
  <data key="d1">other</data>
  <data key="d2">A committee formed to oversee and execute the destruction of documents in accordance with legal and regulatory requirements.&lt;SEP&gt;A committee established to decide on the destruction of documents, featuring a chairman and at least two members.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-026</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="บัญชีหนังสือขอทําลาย">
  <data key="d0">บัญชีหนังสือขอทําลาย</data>
  <data key="d1">data</data>
  <data key="d2">A formal record detailing documents proposed for destruction, which includes metadata such as titles, dates, and other identifying information.&lt;SEP&gt;An official list that records documents being considered for destruction by the committee.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-026</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ระเบียบการทําลายหนังสือ">
  <data key="d0">ระเบียบการทําลายหนังสือ</data>
  <data key="d1">concept</data>
  <data key="d2">A set of regulations governing the procedures and protocols for the destruction of documents within a governmental framework.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="เอกสาร">
  <data key="d0">เอกสาร</data>
  <data key="d1">other</data>
  <data key="d2">Documents that are managed, borrowed, or prepared for destruction by the officials and committees mentioned in the regulatory context.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
<node id="ระยะเวลาการเก็บหนังสือ">
  <data key="d0">ระยะเวลาการเก็บหนังสือ</data>
  <data key="d1">concept</data>
  <data key="d2">The timeframe within which documents must be stored before they can be considered for destruction or review as per the regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
  <data key="d6"></data>
</node>
