  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1789045495</data>
  <data key="d13"></data>
</edge>
<edge source="ผูยืม" target="เจาหนาที่เก็บ">
  <data key="d7">1.0</data>
  <data key="d8">The borrower provides documentation of the borrowing to the staff member and the staff member collects and organizes the borrowing evidence.</data>
  <data key="d9">collects,gives</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1789045495</data>
  <data key="d13"></data>
</edge>
<edge source="ผูยืม" target="เอกสารสิทธิตามกฎหมาย">
  <data key="d7">1.0</data>
  <data key="d8">The legal documents require the borrower to report them if lost, instigating a specific process for recovery or replacement.</data>
  <data key="d9">requires</data>
