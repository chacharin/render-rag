  <data key="d7">1.0</data>
  <data key="d8">Indicates that statements are also required to be printed on the same special paper.</data>
  <data key="d9">uses</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
