  <data key="d1">person</data>
  <data key="d2">ผูรับผิดชอบ denotes an individual appointed to oversee and ensure the execution of specific tasks or responsibilities, usually within a professional or administrative context.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-004</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1789045491</data>
